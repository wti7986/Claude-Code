# TypeSafe AI (Jev) - typo screening
TYPESAFE_API_KEY=

# Shared secret between this backend and the extension. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The extension must send it as: Authorization: Bearer <this value>
APP_SHARED_TOKEN=

# Optional
PORT=3300
# Probability (0-1) above which a sentence is flagged as a likely typo
TYPO_FLAG_THRESHOLD=0.5
# Max /api/check requests per client per minute
RATE_LIMIT_PER_MINUTE=30
